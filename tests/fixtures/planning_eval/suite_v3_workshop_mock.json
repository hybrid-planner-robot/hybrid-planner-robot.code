{
  "name": "planning_eval_suite_v3_workshop_mock",
  "description": "Parallel planning-only suite for the workshop robot. Not mixed into household claim 2 (n=10). Workshop catalog is {cut, drill, paint, clamp}; household pour/stir/tilt are not candidates. Same four default arms as v3 mock.",
  "defaults": {
    "hybrid": "mvp",
    "control": "fd",
    "goal_backend": "local_llm",
    "domain_select": "llm",
    "scene_source": "oracle",
    "perception_only": false,
    "plan_only": true,
    "max_steps": 1,
    "arms": [
      "llm_plan",
      "llm_pddl",
      "enrich",
      "r1"
    ]
  },
  "families": {
    "template_complete": "Fixed-domain pick/place/stack/look on workshop symbols. Same types as tabletop, different robot scene.",
    "needs_enrichment": "Workshop catalog skills. Own strata — do not add these to kitchen claim 2.",
    "ungenerable": "No catalog skill (solder/weld). Pass = refuse."
  },
  "cases": [
    {
      "id": "explicit_place",
      "task": "place the hammer on the metal tray",
      "world": "workshop",
      "phrasing": "explicit",
      "family": "template_complete",
      "expect": {
        "template": "manipulation_base",
        "completeness": "complete",
        "required_init": [["on", "hammer", "table"], ["clear", "hammer"], ["gripper-empty"]],
        "gold_goal": [["on", "hammer", "metal_tray"]],
        "plan_actions": ["pick", "place"],
        "select": {"plan": true},
        "enrich": {"path": "complete", "plan": true},
        "r1": {"path": "complete", "plan": true}
      }
    },
    {
      "id": "implicit_place",
