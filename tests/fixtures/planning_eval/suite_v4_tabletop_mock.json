{
  "name": "planning_eval_suite_v4_tabletop_mock",
  "description": "V4 tabletop setting. Template pick/place/look-at/stack, refuse, long plan, underspecified. No enrichment family. Four default arms.",
  "defaults": {
    "hybrid": "mvp",
    "control": "fd",
    "goal_backend": "local_llm",
    "domain_select": "llm",
    "scene_source": "oracle",
    "perception_only": false,
    "plan_only": true,
    "max_steps": 1,
    "arms": [
      "llm_plan",
      "llm_pddl",
      "enrich",
      "r1"
    ],
    "report_style": "families",
    "world": "tabletop"
  },
  "phrasing": {
    "explicit": "NL names the motor skill (or a close synonym) and its arguments.",
    "implicit": "NL states a need, condition, or goal without naming the skill."
  },
  "families": {
    "template_complete": "Fixed-domain pick/place/look-at/stack. No catalog gap. Enrich/r1 must stay on the complete path.",
    "ungenerable": "Nothing in the catalog can close the gap. Same four tasks on every setting. Pass = refuse, not a spurious pick/place plan.",
    "long_sequence": "Template sequences of 4+ actions (pick/place/stack). No enrichment.",
    "underspecified": "NL does not determine a unique modeled outcome. Pass = refuse or a plan in the allowlist; fail = spurious skill."
  },
