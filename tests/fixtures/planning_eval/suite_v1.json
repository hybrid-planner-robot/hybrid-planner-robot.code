{
  "name": "planning_eval_suite_v1",
  "description": "Planning-only battery (active perception + hybrid :init/:goal + Fast Downward; no arm execution). Two arms: domain selection without enrichment, and closed-catalog enrichment. Phrasing is explicit vs implicit (LLM translation load). Family splits 10 template-complete (claim 1), 10 enrichment-gap (claim 2), and 4 ungenerable refuse (claim 3). Claim 2 is never the sum of claim 1.",
  "defaults": {
    "hybrid": "mvp",
    "control": "fd",
    "goal_backend": "local_llm",
    "domain_select": "llm",
    "scene_source": "dino",
    "perception_only": true,
    "plan_only": true,
    "max_steps": 1
  },
  "phrasing": {
    "explicit": "NL names the motor skill (or a close synonym) and its arguments. Example: pick the bottle / pour the can into the glass.",
    "implicit": "NL states a need, condition, or goal without naming the skill. Example: I am thirsty."
  },
  "families": {
    "template_complete": "A fixed domain template already has the actions. Claim 1 = select arm on these 10. Enricher must not be called; enrich-on-complete is a side check, not claim 2.",
    "needs_enrichment": "A catalog skill (pour/stir/cut/tilt) is required. Claim 2 = enrich arm on these 10 only. Select-only should not produce a valid gap-skill plan.",
    "ungenerable": "Nothing in the catalog can close the gap. Pass = refuse, not a spurious pick/place plan. Scored separately from plan success."
  },
  "cases": [
    {
      "id": "explicit_place",
      "task": "place the wood cube on the shelf",
      "world": "tabletop",
      "phrasing": "explicit",
      "family": "template_complete",
      "expect": {
        "template": "manipulation_base",
        "completeness": "complete",
        "required_init": [
          ["on", "wood_cube", "table"],
          ["clear", "wood_cube"],
          ["gripper-empty"]
        ],
        "gold_goal": [["on", "wood_cube", "shelf"]],
        "plan_actions": ["pick", "place"],
        "select": {"plan": true},
        "enrich": {"path": "complete", "plan": true}
      },
      "note": "Canonical explicit pick-place. wood_cube / shelf on tabletop."
    },
    {
      "id": "implicit_place",
