{
  "name": "planning_eval_suite_v3_mock",
  "description": "Mock-perception planning battery v3. Claim populations keep unique-gold NL (same 10+10+4 shape as v2, plus long sequences). Open-intent cases live in family underspecified and are excluded from claims 1–3.",
  "defaults": {
    "hybrid": "mvp",
    "control": "fd",
    "goal_backend": "local_llm",
    "domain_select": "llm",
    "scene_source": "oracle",
    "perception_only": false,
    "plan_only": true,
    "max_steps": 1,
    "arms": [
      "llm_plan",
      "llm_pddl",
      "enrich",
      "r1"
    ]
  },
  "phrasing": {
    "explicit": "NL names the motor skill (or a close synonym) and its arguments. Example: pick the bottle / pour the can into the glass.",
    "implicit": "NL states a need, condition, or goal without naming the skill. Example: the glass should be filled from the can."
  },
  "families": {
    "template_complete": "A fixed domain template already has the actions. Claim 1 = select arm on these 10. Enricher must not be called; enrich-on-complete is a side check, not claim 2.",
    "needs_enrichment": "A catalog skill (pour/stir/cut/tilt) is required. Claim 2 = enrich arm on these 10 only. Select-only should not produce a valid gap-skill plan.",
    "ungenerable": "Nothing in the catalog can close the gap. Pass = refuse, not a spurious pick/place plan. Scored separately from plan success.",
    "long_sequence": "Template sequences of 4+ actions (pick/place/stack). No enrichment.",
    "underspecified": "NL does not determine a unique modeled outcome (no recipient, no liquid, unmodeled observer, etc.). Pass = refuse or a plan in the allowlist; fail = spurious skill. Not in claim 1–3 denominators."
  },
